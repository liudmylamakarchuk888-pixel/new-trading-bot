# Copy this file to .env and pick exactly ONE BOT_DATABASE_URL.

# ============================================================
# Database (PostgreSQL)
# ============================================================

# --- 1. Local development (start with: docker compose up -d) ---
BOT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trading_bot

# --- 2. VPS database from your local machine (Supabase Postgres on the VPS,
#        container port 5432 is published as 54322) ---
# BOT_DATABASE_URL=postgresql://postgres:postgres-dev-password@141.136.44.1:54322/trading_bot

# --- 3. When the bot runs ON the VPS itself ---
# BOT_DATABASE_URL=postgresql://postgres:postgres-dev-password@localhost:54322/trading_bot

# ============================================================
# Bot settings (optional, defaults in app/config.py)
# ============================================================
# BOT_BANKROLL=500
# BOT_MIN_EDGE=0.02
# BOT_COST=0.01
# BOT_MAX_SPREAD=0.08
# BOT_DAILY_LOSS_FRAC=0.03
