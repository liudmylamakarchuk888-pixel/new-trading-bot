# Copy this file to .env and pick exactly ONE BOT_DATABASE_URL.

# ============================================================
# Database (PostgreSQL)
# ============================================================

# --- 1. Local development (start with: docker compose up -d) ---
BOT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trading_bot

# --- 2. VPS database from your local machine (Supabase Postgres on the VPS,
#        container port 5432 is published as 54322; the server has SSL off) ---
# BOT_DATABASE_URL=postgresql://postgres:postgres-dev-password@141.136.44.1:54322/trading_bot?sslmode=disable

# --- 3. When the bot runs ON the VPS itself ---
# BOT_DATABASE_URL=postgresql://postgres:postgres-dev-password@localhost:54322/trading_bot?sslmode=disable

# ============================================================
# Bot settings — conservative defaults (see app/config.py)
# Set BOT_TRADE_ENABLED=true only after paper validation passes.
# ============================================================
# BOT_TRADE_ENABLED=false
# BOT_MIN_EDGE=0.10
# BOT_PAPER_MIN_TTE_HOURS=24
# BOT_PAPER_MAX_TTE_HOURS=72
# BOT_ALLOW_NO_SIDE=false
# BOT_MAX_MARKET_EXPOSURE_USD=5
# BOT_MAX_UNDERLYING_DAY_EXPOSURE_USD=25
# BOT_MAX_TOTAL_EXPOSURE_USD=100
# BOT_DAILY_LOSS_LIMIT_USD=10
# BOT_ORDER_TTL_SECONDS=20
# BOT_CANCEL_IF_EDGE_BELOW=0.00
# BOT_CANCEL_IF_ADVERSE_SPOT_BPS=5
# BOT_REPLACE_ONLY_IF_PRICE_IMPROVES_TICKS=2
# BOT_REQUIRE_CALIBRATED_BUCKET=true
# BOT_MIN_BUCKET_SETTLEMENTS=50
# BOT_BLOCK_CROSSED_BOOK_ARB=true
